<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules preventing database and sensitive financial data leakage -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude Room SQLite database containing member bank accounts and transactions -->
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
