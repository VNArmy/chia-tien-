# AI_BACKEND_URL: Optional backend proxy URL for AI Spending Advisor.
# To prevent extraction of secret API keys from client APK decompilation,
# the Android client NEVER embeds direct Gemini API keys.
# All requests are securely proxied via your backend server (e.g., Cloud Run / Cloud Functions)
# protected by Firebase App Check.
# AI_BACKEND_URL=https://your-cloud-backend.run.app/analyze
